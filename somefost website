<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Somefost Solutions Limited — Housing Finance & IT Sales</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
:root{
  --sea:#1a9ec5;--sea-light:#d6f0f9;--sea-mid:#4dbcd8;
  --sea-dark:#0c6d8f;--sea-deep:#063348;--sea-deeper:#031d2a;
  --pink:#e03c6a;--pink-light:#fde0eb;--pink-mid:#ee7498;--pink-dark:#b02050;
  --white:#fff;--cream:#f4f9fc;--text:#0d1c24;--muted:#5a717a;--border:#bce4f4;
}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text);overflow-x:hidden}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:999;height:72px;
  display:flex;align-items:center;justify-content:space-between;padding:0 5%;
  background:rgba(3,29,42,0.97);backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(77,188,216,0.15);transition:background .3s}
.nl-wrap{display:flex;align-items:center;gap:11px}
.nl-img{height:50px;width:auto;filter:drop-shadow(0 2px 8px rgba(26,158,197,.45))}
.nl-brand{display:flex;flex-direction:column;line-height:1.2}
.nl-brand strong{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#fff;letter-spacing:.2px}
.nl-brand span{font-size:.57rem;color:var(--sea-mid);letter-spacing:2.5px;text-transform:uppercase;font-weight:500}
.nlinks{display:flex;gap:2rem;list-style:none}
.nlinks a{color:rgba(255,255,255,.58);text-decoration:none;font-size:.84rem;font-weight:500;transition:color .2s}
.nlinks a:hover{color:var(--sea-mid)}
.nacts{display:flex;gap:.7rem;align-items:center}
.btn-ng{background:transparent;color:rgba(255,255,255,.65);border:1px solid rgba(255,255,255,.18);
  border-radius:7px;padding:.48rem 1.1rem;font-size:.81rem;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .2s}
.btn-ng:hover{border-color:var(--sea-mid);color:var(--sea-mid)}
.btn-nc{background:var(--pink);color:#fff;border:none;border-radius:7px;
  padding:.5rem 1.25rem;font-size:.81rem;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;transition:background .2s}
.btn-nc:hover{background:var(--pink-dark)}

/* ── HERO ── */
.hero{min-height:100vh;background:var(--sea-deeper);padding:120px 5% 80px;
  display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:3rem;
  position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 65% 60% at 78% 35%,rgba(26,158,197,.14) 0%,transparent 65%),
             radial-gradient(ellipse 45% 45% at 12% 75%,rgba(224,60,106,.1) 0%,transparent 60%)}
.hgrid{position:absolute;inset:0;
  background-image:linear-gradient(rgba(77,188,216,.032) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(77,188,216,.032) 1px,transparent 1px);
  background-size:58px 58px}
.hclip{position:absolute;bottom:0;left:0;right:0;height:88px;
  background:var(--cream);clip-path:polygon(0 100%,100% 22%,100% 100%);z-index:2}
.hleft{position:relative;z-index:3}
.hpill{display:inline-flex;align-items:center;gap:8px;
  background:rgba(26,158,197,.17);border:1px solid rgba(77,188,216,.33);
  border-radius:50px;padding:.3rem 1rem;margin-bottom:1.7rem}
.hpill .dot{width:6px;height:6px;border-radius:50%;background:var(--sea-mid);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hpill span{font-size:.71rem;color:var(--sea-mid);letter-spacing:1.5px;text-transform:uppercase;font-weight:600}
.hleft h1{font-family:'Playfair Display',serif;font-size:clamp(2.6rem,4.2vw,4rem);
  font-weight:700;line-height:1.1;color:#fff;margin-bottom:1.4rem}
.hleft h1 em{color:var(--pink-mid);font-style:italic}
.hleft h1 .sc{color:var(--sea-mid)}
.hleft p{font-size:.98rem;color:rgba(255,255,255,.57);line-height:1.82;max-width:490px;margin-bottom:2.3rem;font-weight:300}
.hbtns{display:flex;gap:.85rem;flex-wrap:wrap;margin-bottom:2.6rem}
.btn-sea{background:linear-gradient(135deg,var(--sea) 0%,var(--sea-dark) 100%);color:#fff;border:none;border-radius:9px;
  padding:.88rem 1.9rem;font-size:.92rem;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s;
  text-decoration:none;display:inline-block;box-shadow:0 5px 22px rgba(26,158,197,.4)}
.btn-sea:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(26,158,197,.52)}
.btn-pk{background:var(--pink);color:#fff;border:none;border-radius:9px;
  padding:.88rem 1.9rem;font-size:.92rem;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s;
  text-decoration:none;display:inline-block;box-shadow:0 5px 22px rgba(224,60,106,.38)}
.btn-pk:hover{transform:translateY(-2px);background:var(--pink-dark)}
.btn-ol{background:transparent;color:rgba(255,255,255,.75);border:1.5px solid rgba(255,255,255,.22);border-radius:9px;
  padding:.88rem 1.9rem;font-size:.92rem;font-weight:400;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s;
  text-decoration:none;display:inline-block}
.btn-ol:hover{border-color:var(--sea-mid);color:var(--sea-mid);transform:translateY(-2px)}
.htrust{display:flex;gap:1.5rem;flex-wrap:wrap}
.tchip{display:flex;align-items:center;gap:6px;font-size:.76rem;color:rgba(255,255,255,.4)}

/* Hero right: floating cards */
.hright{position:relative;z-index:3;display:flex;flex-direction:column;gap:1.1rem}
.dc{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(16px);border-radius:18px;padding:1.2rem 1.45rem}
.dc.f1{animation:flt 5s ease-in-out infinite}
.dc.f2{animation:flt 5s ease-in-out infinite;animation-delay:1.7s;margin-left:28px}
.dc.f3{animation:flt 5s ease-in-out infinite;animation-delay:3.2s}
@keyframes flt{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
.dc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.85rem}
.dc-lbl{font-size:.66rem;color:rgba(255,255,255,.4);letter-spacing:1.8px;text-transform:uppercase}
.dcbadge{font-size:.63rem;padding:.2rem .65rem;border-radius:4px;font-weight:600}
.dbs{background:rgba(77,188,216,.22);color:var(--sea-mid)}
.dbp{background:rgba(224,60,106,.22);color:var(--pink-mid)}
.dbg{background:rgba(201,168,76,.2);color:#c9a84c}
.dc-title{font-family:'Playfair Display',serif;font-size:1.03rem;font-weight:600;color:#fff;margin-bottom:2px}
.dc-sub{font-size:.73rem;color:rgba(255,255,255,.38);margin-bottom:.95rem}
.dc-stats{display:flex;gap:1.3rem}
.dcs .n{font-size:1.18rem;font-weight:700;color:var(--sea-mid);display:block;line-height:1}
.dcs .n.pk{color:var(--pink-mid)}
.dcs .l{font-size:.63rem;color:rgba(255,255,255,.35);margin-top:2px}
.dcprog{margin-top:.85rem}
.prog{height:4px;background:rgba(255,255,255,.09);border-radius:2px;overflow:hidden}
.pf{height:100%;border-radius:2px}
.pfs{background:linear-gradient(90deg,var(--sea-dark),var(--sea-mid))}
.pfp{background:linear-gradient(90deg,var(--pink-dark),var(--pink-mid))}
.pglbl{display:flex;justify-content:space-between;font-size:.62rem;color:rgba(255,255,255,.28);margin-top:4px}

/* ── STATS BAND ── */
.sband{background:var(--sea-dark);display:flex;flex-wrap:wrap;justify-content:center}
.sbi{flex:1;min-width:120px;max-width:200px;text-align:center;padding:1.7rem 1rem;
  border-right:1px solid rgba(255,255,255,.09)}
.sbi:last-child{border-right:none}
.sbn{font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--sea-mid);display:block;line-height:1}
.sbn.pk{color:var(--pink-mid)}
.sbl{font-size:.71rem;color:rgba(255,255,255,.44);margin-top:4px;display:block}

/* ── SHARED SECTION ── */
section{padding:5.5rem 5%}
.stag{font-size:.67rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:.6rem}
.stag.s{color:var(--sea)}.stag.p{color:var(--pink)}
.stitle{font-family:'Playfair Display',serif;font-size:clamp(1.85rem,3vw,2.75rem);
  font-weight:700;color:var(--sea-deep);line-height:1.15;margin-bottom:.9rem}
.stitle em{color:var(--pink);font-style:italic}
.stitle .sc{color:var(--sea)}
.ssub{font-size:.93rem;color:var(--muted);line-height:1.82;max-width:510px;margin-bottom:2.8rem;font-weight:300}

/* ── SERVICES ── */
.services{background:var(--white)}
.svc-hdr{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2.8rem;flex-wrap:wrap;gap:1rem}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.svc{border-radius:20px;padding:1.9rem 1.7rem;border:1.5px solid transparent;
  transition:all .3s;position:relative;overflow:hidden;cursor:default}
.svc:hover{transform:translateY(-5px)}
.svc.hf{background:var(--sea-light);border-color:rgba(26,158,197,.2)}
.svc.hf:hover{box-shadow:0 18px 50px rgba(26,158,197,.2);border-color:var(--sea)}
.svc.it{background:var(--pink-light);border-color:rgba(224,60,106,.2)}
.svc.it:hover{box-shadow:0 18px 50px rgba(224,60,106,.2);border-color:var(--pink)}
.svc.dk{background:var(--sea-deep);border-color:rgba(77,188,216,.25)}
.svc.dk:hover{box-shadow:0 18px 50px rgba(3,29,42,.55)}
.svctag{position:absolute;top:1rem;right:1rem;font-size:.6rem;font-weight:700;padding:.2rem .65rem;
  border-radius:4px;letter-spacing:1px;text-transform:uppercase}
.st-hf{background:rgba(26,158,197,.15);color:var(--sea)}
.st-it{background:rgba(224,60,106,.14);color:var(--pink)}
.sico{width:50px;height:50px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:1.2rem}
.is{background:rgba(26,158,197,.14)}.ip{background:rgba(224,60,106,.13)}.iw{background:rgba(255,255,255,.1)}
.svc h3{font-family:'Playfair Display',serif;font-size:1.18rem;font-weight:700;color:var(--sea-deep);margin-bottom:.5rem}
.svc.dk h3{color:#fff}
.svc p{font-size:.84rem;color:var(--muted);line-height:1.72;margin-bottom:1.1rem;font-weight:300}
.svc.dk p{color:rgba(255,255,255,.5)}
.slnk{font-size:.79rem;font-weight:600;color:var(--sea);text-decoration:none;display:inline-flex;align-items:center;gap:4px;transition:gap .2s}
.slnk:hover{gap:8px}.svc.it .slnk{color:var(--pink)}.svc.dk .slnk{color:var(--sea-mid)}

/* ── HOUSING ── */
.housing{background:var(--cream)}
.hin{display:grid;grid-template-columns:1fr 1fr;gap:4.5rem;align-items:center}
.calcbox{background:var(--white);border-radius:24px;border:1px solid var(--border);padding:2rem;
  box-shadow:0 8px 40px rgba(26,158,197,.09)}
.chdr{display:flex;align-items:center;gap:8px;font-family:'Playfair Display',serif;
  font-size:1.18rem;font-weight:700;color:var(--sea-deep);margin-bottom:1.5rem}
.chdr .dot{width:9px;height:9px;border-radius:50%;background:var(--sea)}
.cf{margin-bottom:1.1rem}
.cf label{font-size:.7rem;font-weight:700;color:var(--muted);display:block;margin-bottom:5px;letter-spacing:1px;text-transform:uppercase}
.cf input,.cf select{width:100%;padding:.72rem 1rem;border:1.5px solid var(--border);border-radius:10px;
  font-size:.92rem;font-family:'DM Sans',sans-serif;color:var(--text);background:var(--cream);
  outline:none;transition:border-color .2s;-webkit-appearance:none}
.cf input:focus,.cf select:focus{border-color:var(--sea);background:#fff}
.cfrow{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.cres{background:var(--sea-deep);border-radius:14px;padding:1.2rem 1.4rem;
  display:flex;justify-content:space-between;align-items:center;margin-top:1.2rem}
.crl .lbl{font-size:.71rem;color:rgba(255,255,255,.42);margin-bottom:3px}
.crl .amt{font-family:'Playfair Display',serif;font-size:1.85rem;font-weight:700;color:var(--sea-mid)}
.crl .note{font-size:.64rem;color:rgba(255,255,255,.28);margin-top:2px}
.crr{text-align:right}
.crr .lbl{font-size:.71rem;color:rgba(255,255,255,.42);margin-bottom:3px}
.crr .val{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--pink-mid)}
.cbtn{width:100%;margin-top:1rem;background:linear-gradient(135deg,var(--sea),var(--sea-dark));
  color:#fff;border:none;border-radius:10px;padding:.9rem;font-size:.92rem;font-weight:700;
  font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s;box-shadow:0 4px 18px rgba(26,158,197,.35)}
.cbtn:hover{box-shadow:0 8px 26px rgba(26,158,197,.5);transform:translateY(-1px)}
.lchips{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-top:1.1rem}
.lch{display:flex;align-items:center;gap:6px;background:var(--sea-light);
  border:1px solid rgba(26,158,197,.2);border-radius:8px;padding:.55rem .8rem;
  font-size:.75rem;color:var(--sea-dark);font-weight:500}
.flist{list-style:none;margin-bottom:2.4rem}
.flist li{display:flex;align-items:flex-start;gap:.9rem;padding:.88rem 0;border-bottom:1px solid var(--border)}
.flist li:last-child{border:none}
.fli{width:36px;height:36px;border-radius:10px;background:var(--sea-light);
  display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.flt h4{font-size:.9rem;font-weight:600;color:var(--sea-deep);margin-bottom:2px}
.flt p{font-size:.79rem;color:var(--muted);line-height:1.55;font-weight:300}

/* ── IT SALES ── */
.itsec{background:var(--sea-deeper);position:relative;overflow:hidden}
.itsec::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 50% 55% at 85% 25%,rgba(224,60,106,.12) 0%,transparent 60%),
             radial-gradient(ellipse 40% 45% at 15% 75%,rgba(26,158,197,.1) 0%,transparent 60%)}
.itin{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:4.5rem;align-items:center}
.itin .stitle{color:#fff}.itin .stitle .pem{color:var(--pink-mid);font-style:italic}
.itin .ssub{color:rgba(255,255,255,.47);max-width:100%}
.itgrid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2.5rem}
.itc{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);
  border-radius:14px;padding:1.15rem;transition:all .25s}
.itc:hover{background:rgba(255,255,255,.09);border-color:rgba(224,60,106,.3);transform:translateY(-3px)}
.itc .ii{font-size:1.5rem;margin-bottom:.62rem}
.itc h4{font-size:.87rem;font-weight:600;color:#fff;margin-bottom:3px}
.itc p{font-size:.75rem;color:rgba(255,255,255,.4);line-height:1.5;font-weight:300}
.tstack{display:flex;flex-direction:column;gap:.82rem}
.tslbl{font-size:.63rem;color:rgba(255,255,255,.26);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:.3rem}
.trow{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
  border-radius:12px;padding:.95rem 1.15rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}
.trl{flex:1}
.trn{font-size:.84rem;font-weight:600;color:rgba(255,255,255,.82)}
.trm{font-size:.7rem;color:rgba(255,255,255,.3);margin-top:2px}
.trb{height:3px;background:rgba(255,255,255,.07);border-radius:2px;margin-top:6px;overflow:hidden}
.trf{height:100%;border-radius:2px}
.tfs{background:linear-gradient(90deg,var(--sea-dark),var(--sea-mid))}
.tfp{background:linear-gradient(90deg,var(--pink-dark),var(--pink-mid))}
.tfm{background:linear-gradient(90deg,var(--sea),var(--pink))}
.trbdg{font-size:.68rem;font-weight:700;white-space:nowrap}
.trbdg.s{color:var(--sea-mid)}.trbdg.p{color:var(--pink-mid)}.trbdg.g{color:#c9a84c}

/* ── LISTINGS ── */
.listings{background:var(--white)}
.lhdr{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2.5rem;flex-wrap:wrap;gap:1rem}
.frow{display:flex;gap:.55rem;flex-wrap:wrap;margin-bottom:2.5rem}
.fb{padding:.42rem 1.1rem;border-radius:50px;border:1.5px solid var(--border);background:var(--cream);
  font-size:.79rem;cursor:pointer;font-family:'DM Sans',sans-serif;color:var(--muted);transition:all .2s;font-weight:500}
.fb.active,.fb:hover{background:var(--sea);border-color:var(--sea);color:#fff}
.fb.pf.active,.fb.pf:hover{background:var(--pink);border-color:var(--pink)}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.pc{border-radius:20px;overflow:hidden;border:1px solid var(--border);background:var(--white);transition:all .3s;cursor:pointer}
.pc:hover{transform:translateY(-6px);box-shadow:0 20px 50px rgba(26,158,197,.14)}
.pthumb{height:192px;display:flex;align-items:center;justify-content:center;font-size:4.5rem;position:relative}
.bg1{background:linear-gradient(135deg,#d6f0f9,#b5dff0)}
.bg2{background:linear-gradient(135deg,#fde0eb,#f9c0d5)}
.bg3{background:linear-gradient(135deg,#d6f0f9,#fde0eb)}
.bg4{background:linear-gradient(135deg,#e0f5dc,#d6f0f9)}
.bg5{background:linear-gradient(135deg,#fff5de,#fde0eb)}
.bg6{background:linear-gradient(135deg,#e6e8f8,#d6f0f9)}
.ptyp{position:absolute;top:12px;left:12px;border-radius:6px;padding:.22rem .65rem;
  font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.pt-h{background:var(--sea);color:#fff}.pt-a{background:var(--pink);color:#fff}.pt-i{background:var(--sea-deep);color:#fff}
.psave{position:absolute;top:10px;right:12px;background:rgba(255,255,255,.88);border:none;
  border-radius:50%;width:32px;height:32px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center}
.pbdy{padding:1rem 1.15rem 1.2rem}
.ppr{font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:var(--sea-dark);margin-bottom:3px}
.ppr.pk{color:var(--pink-dark)}
.pnm{font-size:.86rem;font-weight:600;color:var(--text);margin-bottom:3px}
.ploc{font-size:.74rem;color:var(--muted);margin-bottom:9px}
.pspecs{display:flex;gap:.9rem;font-size:.73rem;color:var(--muted);padding-top:9px;border-top:1px solid var(--border)}

/* ── WHY ── */
.why{background:var(--cream)}
.wgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}
.wi{text-align:center}
.wico{width:66px;height:66px;border-radius:20px;display:flex;align-items:center;justify-content:center;
  font-size:1.7rem;margin:0 auto 1.1rem}
.ws{background:var(--sea-light)}.wp{background:var(--pink-light)}
.wi h3{font-family:'Playfair Display',serif;font-size:1.08rem;font-weight:700;color:var(--sea-deep);margin-bottom:.44rem}
.wi p{font-size:.82rem;color:var(--muted);line-height:1.65;font-weight:300}

/* ── TESTIMONIALS ── */
.testi{background:var(--white)}
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.tc{background:var(--cream);border-radius:20px;padding:1.8rem;border:1px solid var(--border);transition:box-shadow .25s}
.tc:hover{box-shadow:0 12px 36px rgba(26,158,197,.1)}
.tc.dk{background:var(--sea-deep);border-color:rgba(77,188,216,.2)}
.tcstars{color:#f0b429;font-size:.84rem;margin-bottom:.8rem}
.tcq{font-size:2.4rem;color:var(--sea-light);line-height:1;margin-bottom:.7rem;font-family:'Playfair Display',serif}
.tc.dk .tcq{color:rgba(77,188,216,.25)}
.tctxt{font-size:.86rem;color:var(--muted);line-height:1.77;font-style:italic;margin-bottom:1.3rem;font-weight:300}
.tc.dk .tctxt{color:rgba(255,255,255,.48)}
.tcauth{display:flex;align-items:center;gap:.75rem}
.tav{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.84rem}
.tas{background:var(--sea-light);color:var(--sea-dark)}
.tap{background:var(--pink-light);color:var(--pink-dark)}
.tad{background:rgba(77,188,216,.18);color:var(--sea-mid)}
.tanm{font-size:.85rem;font-weight:600;color:var(--text)}
.tc.dk .tanm{color:#fff}
