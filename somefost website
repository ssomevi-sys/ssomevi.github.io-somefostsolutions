/* ── CTA ── */
.ctawrap{margin:0 5% 5.5rem;border-radius:28px;
  background:linear-gradient(120deg,var(--sea-deep) 0%,var(--sea-dark) 55%,#1a9fc0 100%);
  padding:4.5rem 5%;display:grid;grid-template-columns:1fr auto;align-items:center;gap:3rem;
  position:relative;overflow:hidden}
.ctawrap::before{content:'';position:absolute;right:-80px;top:-80px;width:360px;height:360px;border-radius:50%;
  background:radial-gradient(circle,rgba(224,60,106,.22) 0%,transparent 70%)}
.ctawrap::after{content:'';position:absolute;left:35%;bottom:-80px;width:220px;height:220px;border-radius:50%;
  background:radial-gradient(circle,rgba(77,188,216,.15) 0%,transparent 70%)}
.ctatxt{position:relative;z-index:1}
.ctatxt .tag{font-size:.67rem;font-weight:700;color:var(--sea-mid);letter-spacing:3px;text-transform:uppercase;margin-bottom:.7rem;display:block}
.ctatxt h2{font-family:'Playfair Display',serif;font-size:2.25rem;color:#fff;line-height:1.1;margin-bottom:.7rem}
.ctatxt h2 em{color:var(--pink-mid);font-style:italic}
.ctatxt p{font-size:.92rem;color:rgba(255,255,255,.47);font-weight:300}
.ctaacts{position:relative;z-index:1;display:flex;flex-direction:column;gap:.8rem;min-width:208px}
.btncp{display:block;text-align:center;text-decoration:none;background:var(--pink);color:#fff;border:none;border-radius:10px;
  padding:1rem 2rem;font-size:.94rem;font-weight:700;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s;
  box-shadow:0 5px 22px rgba(224,60,106,.4)}
.btncp:hover{background:var(--pink-dark);transform:translateY(-2px)}
.btncg{display:block;text-align:center;text-decoration:none;background:rgba(255,255,255,.09);
  color:rgba(255,255,255,.72);border:1px solid rgba(255,255,255,.18);border-radius:10px;
  padding:1rem 2rem;font-size:.94rem;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .25s}
.btncg:hover{background:rgba(255,255,255,.15);color:#fff}

/* ── NEWSLETTER ── */
.nl-sec{background:var(--sea-deep);text-align:center;padding:5rem 10%}
