<script>
function calcMtg(){
  var P=parseFloat(document.getElementById('propVal').value)||0;
  var d=parseFloat(document.getElementById('downPct').value)||20;
  var y=parseInt(document.getElementById('loanTerm').value)||20;
  var r=parseFloat(document.getElementById('intRate').value)||22;
  var loan=P*(1-d/100);
  var mr=r/100/12;
  var n=y*12;
  var m=loan*mr*Math.pow(1+mr,n)/(Math.pow(1+mr,n)-1);
  document.getElementById('monthly').textContent=isFinite(m)?'₵'+Math.round(m).toLocaleString():'—';
  document.getElementById('loanAmt').textContent='₵'+Math.round(loan).toLocaleString();
}
function setF(el){document.querySelectorAll('.fb').forEach(function(b){b.classList.remove('active')});el.classList.add('active');}
function toggleSave(btn){btn.textContent=btn.textContent==='🤍'?'❤️':'🤍';}
var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)';}});},{threshold:.07});
document.querySelectorAll('.svc,.pc,.tc,.wi,.itc,.trow,.lch').forEach(function(el){el.style.opacity='0';el.style.transform='translateY(20px)';el.style.transition='opacity 0.5s ease,transform 0.5s ease';obs.observe(el);});
window.addEventListener('scroll',function(){var nav=document.getElementById('topnav');nav.style.background=window.scrollY>60?'rgba(3,29,42,0.99)':'rgba(3,29,42,0.97)';});
